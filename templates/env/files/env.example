# Plantilla de variables de entorno. Copia a .env y rellena. Los secretos van VACÍOS aquí:
# nunca pongas valores reales en este archivo (se versiona).
APP_NAME={{ project.name }}
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Orígenes permitidos por CORS (lista exacta separada por coma; nunca "*").
CORS_ALLOWED_ORIGINS=http://localhost
# IPs/CIDR de tus balanceadores de confianza (coma) o vacío si no hay proxy.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos: sqlite para desarrollo rápido; mysql en Docker/producción.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Autenticación (Passport). Vida de los tokens y límite de intentos de login.
PASSPORT_ACCESS_TTL_HOURS=24
PASSPORT_REFRESH_TTL_DAYS=30
LOGIN_ATTEMPTS_PER_MINUTE=6
# Opcional: llaves OAuth por variable (si no, `php artisan authentications:setup` las crea en storage/).
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

OCTANE_SERVER=roadrunner

# Correo
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# AWS (almacenamiento/correo). Déjalas vacías en local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# Terceros (inicio de sesión social). Vacío = deshabilitado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_NATIVE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers
APPLE_ENABLED=false
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Frontend (públicas: terminan en el bundle del navegador).
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_API_URL=/api
