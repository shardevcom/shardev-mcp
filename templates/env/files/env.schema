# ======================================================================
# Clasificación de variables de entorno (solo NOMBRES, nunca valores)
# ======================================================================
#   secret   -> credencial o dato sensible. Va a un gestor de secretos, nunca a un archivo versionado.
#   public   -> el nombre "parece" secreto pero el valor es público (IDs de OAuth...).
#   exclude  -> nunca se envía al contenedor (herramientas locales).
# Todo lo no listado va como configuración normal. Las VITE_* terminan en el JS del navegador:
# son públicas siempre y no pueden ser secret.
# ======================================================================

# --- Aplicación ---------------------------------------------------------
secret  APP_KEY
secret  PASSPORT_PRIVATE_KEY
public  PASSPORT_PUBLIC_KEY

# --- Base de datos / Redis ----------------------------------------------
secret  DB_PASSWORD
secret  DB_ROOT_PASSWORD
secret  REDIS_PASSWORD
secret  MAIL_PASSWORD

# --- AWS ----------------------------------------------------------------
secret  AWS_ACCESS_KEY_ID
secret  AWS_SECRET_ACCESS_KEY

# --- Inicio de sesión social ---------------------------------------------
secret  GOOGLE_CLIENT_SECRET
public  GOOGLE_CLIENT_ID
public  GOOGLE_NATIVE_CLIENT_ID
secret  MICROSOFT_CLIENT_SECRET
public  MICROSOFT_CLIENT_ID
secret  APPLE_PRIVATE_KEY
public  APPLE_SERVICE_ID
public  APPLE_BUNDLE_ID
public  APPLE_TEAM_ID
public  APPLE_KEY_ID
