# Entorno LOCAL generado por shardev. No se versiona (.gitignore). Los secretos de abajo son
# aleatorios y solo valen para esta máquina; las credenciales de terceros están vacías.
APP_NAME={{ project.name }}
APP_ENV=local
APP_KEY={{ secret.app_key }}
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

CORS_ALLOWED_ORIGINS=http://localhost
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME={{ project.name }}
DB_PASSWORD={{ secret.db_password }}
DB_ROOT_PASSWORD={{ secret.db_root_password }}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD={{ secret.redis_password }}
REDIS_PORT=6379

PASSPORT_ACCESS_TTL_HOURS=24
PASSPORT_REFRESH_TTL_DAYS=30
LOGIN_ATTEMPTS_PER_MINUTE=6

OCTANE_SERVER=roadrunner

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@{{ project.domain }}
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_API_URL=/api
