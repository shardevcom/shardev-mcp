{
    "name": "shardevcom/verification",
    "description": "Desafíos de verificación de identidad (OTP por email) con hash, intentos máximos y enfriamiento.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "shardevcom/repositories": "^1.0",
        "shardevcom/supports": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Shardevcom\\Verification\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shardevcom\\Verification\\VerificationServiceProvider"
            ]
        }
    }
}
