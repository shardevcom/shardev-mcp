{
    "name": "shardevcom/authentications",
    "description": "Login por app (guards de token Passport y de sesión), perfil, cambio de contraseña, roles y permisos.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "spatie/laravel-permission": "^7.0 || ^8.0",
        "shardevcom/repositories": "^1.0",
        "shardevcom/supports": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Shardevcom\\Authentications\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shardevcom\\Authentications\\AuthenticationsServiceProvider"
            ]
        }
    }
}
