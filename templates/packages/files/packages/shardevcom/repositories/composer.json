{
    "name": "shardevcom/repositories",
    "description": "Capa de repositorios sobre Eloquent con hooks, filtros y operaciones en lote.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Shardevcom\\Repositories\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "orchestra/testbench": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shardevcom\\Repositories\\RepositoryServiceProvider"
            ]
        }
    }
}
